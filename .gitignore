# --- Data & model artifacts (never committed) ---
data/*
!data/README.md
models/*
!models/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Virtual environments ---
.venv/
.venv-dbt/
venv/
env/

# --- dbt / DuckDB ---
# The warehouse file lives under data/ (already ignored); these guard the
# build artifacts and any database written elsewhere.
dbt/target/
dbt/dbt_packages/
dbt/logs/
# Anonymous telemetry id dbt writes on first run; machine-local, not config.
dbt/.user.yml
*.duckdb
*.duckdb.wal

# --- Notebooks ---
.ipynb_checkpoints/

# --- Terraform (keep .terraform.lock.hcl committed) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# --- Kaggle credentials ---
kaggle.json

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
